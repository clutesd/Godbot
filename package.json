    "pacing": "tsx src/pacing.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@types/three": "^0.185.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
