{
  "name": "godbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "art:catalogue": "tsx scripts/construction-art-catalogue.ts",
    "art:acceptance": "node scripts/perf/construction-art-acceptance.mjs",
    "art:report": "node scripts/construction-art-report.mjs",
    "art:check": "node scripts/construction-art-report.mjs --check",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --tags-filter=\"!soak\"",
    "test:soak": "vitest run --tags-filter=soak",
    "test:all": "vitest run",
    "test:watch": "vitest --tags-filter=\"!soak\"",
    "verify": "npm run typecheck && npm run lint && npm test && vite build",
    "sim": "tsx src/headless.ts",
    "batch": "tsx src/batch.ts",
    "pacing": "tsx src/pacing.ts",
    "demography": "tsx scripts/demographic-seeds.ts",
    "profile:camera": "node --import tsx scripts/profile-camera-runtime.ts",
    "profile:narration": "node --import tsx scripts/profile-narration.ts",
    "perf:sim": "tsx scripts/perf/sim-baseline.ts",
    "perf:tick": "tsx scripts/perf/tick-bench.ts",
    "perf:fingerprints": "tsx scripts/perf/fingerprints.ts",
    "perf:frames": "node scripts/perf/frame-harness.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@types/three": "^0.185.0",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
